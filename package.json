{
  "name": "lexhive-funnel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "esbuild api/_lib/*.test.ts --bundle --format=esm --platform=node --outdir=.test-build --out-extension:.js=.mjs --log-level=error && node --test .test-build/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:watch": "E2E_SLOW_MO=450 playwright test --headed --workers=1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vercel": "^59.11.7",
    "vite": "^5.3.4"
  }
}
