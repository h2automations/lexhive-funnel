{
  "name": "LexHive Outbox Drain",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 60
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PUBLIC_BASE_URL }}/api/drain",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-drain-secret",
              "value": "={{ $env.DRAIN_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-drain",
      "name": "Call drain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          { "node": "Call drain", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
