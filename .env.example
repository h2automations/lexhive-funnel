# ---- Client-side (VITE_ prefix means the BROWSER can read it) ----
VITE_META_PIXEL_ID=27653864700958179

# ---- Server-side ONLY. Never add a VITE_ prefix to these. ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same dataset ID as VITE_META_PIXEL_ID, declared separately so the server
# never depends on a browser variable being present.
META_PIXEL_ID=27653864700958179
META_CAPI_ACCESS_TOKEN=
# Leave EMPTY in production — events then flow to live reporting instead of
# the Test Events tab.
META_TEST_EVENT_CODE=
META_API_VERSION=v21.0

N8N_WEBHOOK_URL=
DRAIN_SECRET=change-me-to-a-long-random-string
# Optional. Falls back to DRAIN_SECRET when unset.
OPS_KEY=
SLACK_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:3000
