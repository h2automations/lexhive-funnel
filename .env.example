# ---- Client-side ----
# There is nothing here.
#
# Every browser tag — Meta Pixel, GA4 — is configured in GTM container
# GTM-P34XGVL3, which is installed in index.html. The app pushes to the
# dataLayer (src/lib/datalayer.ts) and the container decides who hears about it,
# so adding a vendor is a container change rather than a deploy.
#
# Environment separation is GTM's own job too: use GTM Environments for
# preview vs live rather than a build-time variable.

# ---- Server-side ONLY. Never add a VITE_ prefix to these. ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The dataset id for SERVER-side Conversions API events. The browser Pixel now
# gets its id from the GTM container instead, so this is the only place the
# application itself needs it.
META_PIXEL_ID=3238075189714579
META_CAPI_ACCESS_TOKEN=
# Leave EMPTY in production — events then flow to live reporting instead of
# the Test Events tab.
META_TEST_EVENT_CODE=
META_API_VERSION=v26.0

N8N_WEBHOOK_URL=
N8N_INTERNAL_SECRET=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
DRAIN_SECRET=change-me-to-a-long-random-string
# Optional. Falls back to DRAIN_SECRET when unset.
OPS_KEY=
PUBLIC_BASE_URL=http://localhost:3000

# ---- Observability ----
# debug | info | warn | error. Leave at info in production; debug is loud and
# a log drain bills by volume.
LOG_LEVEL=info
# Error tracking. Unset means reportError() no-ops, which is what you want
# locally and in tests — nothing to stub.
SENTRY_DSN=
