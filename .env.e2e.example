# Playwright end-to-end environment.
#
# Copy this file to .env.e2e and fill in the blanks. The real environment
# (shell / CI) always wins over this file.
#
# NEVER put a real OPS_KEY, Meta access token, Airtable token, or webhook
# secret in this file or anywhere else in the repo.

# Where the funnel is deployed. Defaults to https://lexhive.vercel.app
BASE_URL=https://lexhive.vercel.app

# Ops key / drain secret for the authenticated /ops assertions.
# Empty (or unset) => that part of the ops test is skipped with a clear reason.
OPS_KEY=

# Contact details used for submitted test leads. E2E_EMAIL and E2E_PHONE are
# optional; when absent they are generated per run so submissions never reuse
# an identifier, and the phone is a clearly fictional US number.
E2E_FIRST_NAME=Playwright
E2E_LAST_NAME=Test
E2E_EMAIL=
E2E_PHONE=
E2E_ZIP=78701